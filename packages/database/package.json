{
  "name": "@recoveryos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && rimraf dist && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed-dropoffs": "tsx prisma/seed-dropoffs.ts",
    "db:seed-extended-recovery": "tsx prisma/seed-extended-recovery.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "prisma generate && vitest run src --passWithNoTests",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@recoveryos/domain": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@recoveryos/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
