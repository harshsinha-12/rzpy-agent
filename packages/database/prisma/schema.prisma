generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum DataSource {
  SIMULATED
  RAZORPAY_TEST_MODE
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  UNKNOWN
}

enum PaymentStatus {
  CREATED
  FAILED
  AUTHORIZED
  CAPTURED
}

enum RecoveryCaseStatus {
  OPEN
  DIAGNOSING
  WAITING
  ACTION_REQUIRED
  RECOVERY_RUNNING
  RECOVERED
  ESCALATED
  STOPPED
  EXHAUSTED
}

enum FailureCategory {
  CUSTOMER_AUTH
  INSUFFICIENT_FUNDS
  GATEWAY_TRANSIENT
  ISSUER_FAILURE
  MERCHANT_ERROR
  NETWORK_ERROR
  UNKNOWN
}

enum RecoverabilityBand {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum ActionType {
  WAIT
  CREATE_PAYMENT_LINK
  SEND_REMINDER
  ALTERNATIVE_METHOD
  ESCALATE
  STOP
}

enum PolicyDecision {
  APPROVED
  DENIED
}

enum ActionResult {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRYING
}

enum Actor {
  WEBHOOK
  DIAGNOSIS_ENGINE
  RECOVERY_AGENT
  POLICY_ENGINE
  EXECUTION_LAYER
  SYSTEM
}

enum WebhookProcessingStatus {
  RECEIVED
  QUEUED
  PROCESSED
  IGNORED
  FAILED
}

model Merchant {
  id         String     @id
  slug       String     @unique
  name       String
  dataSource DataSource
  createdAt  DateTime
  updatedAt  DateTime

  customers      Customer[]
  checkoutDropOffs CheckoutDropOff[]
  extendedRecoveryCases ExtendedRecoveryCase[]
  paymentEvents  PaymentEvent[]
  recoveryCases  RecoveryCase[]
  recoveryPolicy RecoveryPolicy?
  simulationRuns SimulationRun[]
  webhookEvents  WebhookEvent[]
}

model Customer {
  id          String     @id
  merchantId  String
  externalRef String
  email       String?
  phone       String?
  name        String
  optedOut    Boolean    @default(false)
  dataSource  DataSource
  createdAt   DateTime
  updatedAt   DateTime

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutDropOffs CheckoutDropOff[]
  extendedRecoveryCases ExtendedRecoveryCase[]
  paymentEvents PaymentEvent[]
  recoveryCases RecoveryCase[]

  @@unique([merchantId, externalRef])
}

model RecoveryPolicy {
  id                       String       @id
  merchantId               String       @unique
  maxAttemptsPerCase       Int
  maxMessagesPerDay        Int
  minimumRetryDelayMinutes Int
  recoveryWindowHours      Int
  allowedActions           ActionType[]
  dataSource               DataSource
  createdAt                DateTime
  updatedAt                DateTime

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id                String        @id
  merchantId        String
  customerId        String
  razorpayPaymentId String        @unique
  razorpayOrderId   String
  eventType         String
  amountPaise       Int
  currency          String
  paymentMethod     PaymentMethod
  status            PaymentStatus
  errorCode         String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  errorDescription  String?
  occurredAt        DateTime
  rawPayload        Json
  dataSource        DataSource
  createdAt         DateTime

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recoveryCase RecoveryCase?

  @@index([merchantId, occurredAt])
  @@index([razorpayOrderId])
}

model RecoveryCase {
  id                   String             @id
  publicId             String             @unique
  merchantId           String
  customerId           String
  paymentEventId       String             @unique
  amountAtRiskPaise    Int
  recoveredAmountPaise Int                @default(0)
  currency             String
  status               RecoveryCaseStatus
  failureCategory      FailureCategory
  recoverabilityBand   RecoverabilityBand
  recoverabilityScore  Int
  diagnosis            String
  openedAt             DateTime
  closedAt             DateTime?
  lastUpdatedAt        DateTime
  dataSource           DataSource

  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentEvent PaymentEvent     @relation(fields: [paymentEventId], references: [id], onDelete: Cascade)
  actions      RecoveryAction[]
  auditEvents  AuditEvent[]

  @@index([merchantId, status])
  @@index([merchantId, lastUpdatedAt])
}

model RecoveryAction {
  id                String         @id
  caseId            String
  attemptNumber     Int
  actionType        ActionType
  proposedBy        Actor
  reason            String
  confidence        Int
  policyDecision    PolicyDecision
  policyReason      String
  scheduledFor      DateTime?
  executedAt        DateTime?
  result            ActionResult
  razorpayReference String?
  idempotencyKey    String         @unique
  input             Json?
  output            Json?
  dataSource        DataSource
  createdAt         DateTime

  recoveryCase RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  auditEvents  AuditEvent[]

  @@unique([caseId, actionType, attemptNumber])
  @@index([caseId, createdAt])
}

model AuditEvent {
  id         String     @id
  caseId     String
  actionId   String?
  actor      Actor
  eventType  String
  input      Json?
  decision   String?
  reasoning  String?
  output     Json?
  occurredAt DateTime
  dataSource DataSource

  recoveryCase RecoveryCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action       RecoveryAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([caseId, occurredAt])
}

model SimulationRun {
  id                         String     @id
  merchantId                 String
  seed                       Int
  configurationHash          String
  configuration              Json
  paymentCount               Int
  revenueAtRiskPaise         Int
  noInterventionRevenuePaise Int
  recoveredRevenuePaise      Int
  baselineRevenuePaise       Int
  incrementalRevenuePaise    Int
  recoveryRateBps            Int
  attempts                   Int
  falseInterventions         Int
  policyStops                Int
  customerContacts           Int
  dataSource                 DataSource
  startedAt                  DateTime
  completedAt                DateTime
  createdAt                  DateTime

  merchant Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outcomes SimulationOutcome[]

  @@unique([merchantId, seed, configurationHash])
}

model SimulationOutcome {
  id                   String     @id
  runId                String
  paymentIndex         Int
  paymentId            String
  strategy             String
  action               String
  visibleInput         Json
  recovered            Boolean
  recoveredAmountPaise Int
  attempts             Int
  falseIntervention    Boolean
  policyStopped        Boolean
  customerContacted    Boolean
  dataSource           DataSource
  createdAt            DateTime

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, strategy, paymentIndex])
  @@index([runId, strategy])
}

model WebhookEvent {
  id               String                  @id
  merchantId       String
  providerEventId  String                  @unique
  eventType        String
  processingStatus WebhookProcessingStatus
  paymentId        String?
  rawPayload       Json
  dataSource       DataSource
  receivedAt       DateTime
  processedAt      DateTime?
  errorMessage     String?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, receivedAt])
}

enum RecoveryJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  EXHAUSTED
}

enum CheckoutDropOffStatus {
  OPEN
  DRAFT_READY
  STOPPED
}

enum ExtendedRecoveryKind {
  SUBSCRIPTION
  RECEIVABLE
  MANDATE
  VOICE
  UDHAAR
}

enum ExtendedRecoveryStatus {
  OPEN
  DRAFT_READY
  HUMAN_REVIEW
  SNOOZED
  STOPPED
  RECOVERED
}

model ExtendedRecoveryCase {
  id             String                 @id
  publicId       String                 @unique
  merchantId     String
  customerId     String
  kind           ExtendedRecoveryKind
  reference      String                 @unique
  amountPaise    Int
  currency       String
  status         ExtendedRecoveryStatus
  dueAt          DateTime?
  reason         String
  draftSubject   String?
  draftBody      String?
  voiceScript    String?
  operatorAction String?
  createdAt      DateTime
  updatedAt      DateTime
  dataSource     DataSource

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId, kind, status])
}

model RecoveryJob {
  id           String            @id
  queueName    String
  bullJobId    String
  jobName      String
  payload      Json
  status       RecoveryJobStatus
  attemptCount Int               @default(0)
  maxAttempts  Int
  lastError    String?
  caseId       String?
  actionId     String?
  dataSource   DataSource
  scheduledFor DateTime?
  createdAt    DateTime
  updatedAt    DateTime
  completedAt  DateTime?

  @@unique([queueName, bullJobId])
  @@index([status, updatedAt])
}

model CheckoutDropOff {
  id                String                @id
  publicId          String                @unique
  merchantId        String
  customerId        String
  razorpayOrderId   String                @unique
  amountPaise       Int
  currency          String
  status            CheckoutDropOffStatus
  draftSubject      String?
  draftBody         String?
  paymentLinkId     String?
  paymentLinkUrl    String?
  policyDecision    PolicyDecision?
  policyReason      String?
  checkoutCreatedAt DateTime
  lastUpdatedAt     DateTime
  dataSource        DataSource

  merchant Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  auditEvents CheckoutDropOffAudit[]

  @@index([merchantId, status])
  @@index([merchantId, lastUpdatedAt])
  @@unique([paymentLinkId])
}

model CheckoutDropOffAudit {
  id         String     @id
  dropOffId  String
  actor      Actor
  eventType  String
  decision   String?
  reasoning  String?
  output     Json?
  occurredAt DateTime
  dataSource DataSource

  dropOff CheckoutDropOff @relation(fields: [dropOffId], references: [id], onDelete: Cascade)

  @@index([dropOffId, occurredAt])
}
