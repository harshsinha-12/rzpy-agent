{
  "name": "@recoveryos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/worker.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/worker.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/worker.js",
    "test": "vitest run src --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@recoveryos/agents": "workspace:*",
    "@recoveryos/config": "workspace:*",
    "@recoveryos/database": "workspace:*",
    "@recoveryos/domain": "workspace:*",
    "@recoveryos/razorpay": "workspace:*",
    "@recoveryos/recovery-engine": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
