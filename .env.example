RAZORPAY_WEBHOOK_SECRET=

# OpenAI — required starting in Plan Step 7
OPENAI_API_KEY=
OPENAI_MODEL=

# Demo controls
DEMO_SEED=20260820
DEFAULT_DATA_SOURCE=SIMULATED

