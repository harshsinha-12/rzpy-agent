# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local Docker defaults; replace only in an untracked .env file
DATABASE_URL=postgresql://recoveryos:recoveryos@localhost:5432/recoveryos
