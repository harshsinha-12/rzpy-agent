# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKER_HEALTH_URL=http://localhost:4001
API_HOST=0.0.0.0
API_PORT=4000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001

# Local Docker defaults; replace only in an untracked .env file
DATABASE_URL=postgresql://recoveryos:recoveryos@localhost:5432/recoveryos
REDIS_URL=redis://localhost:6380
POSTGRES_PORT=5432
REDIS_PORT=6380

# Razorpay Test Mode — required starting in Plan Step 5
RAZORPAY_TEST_MODE_API_KEY=
RAZORPAY_TEST_MODE_SECRET_KEY=
# Optional until a public signed webhook is configured
RAZORPAY_WEBHOOK_SECRET=

# OpenAI — required starting in Plan Step 7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Demo controls
DEMO_SEED=20260820
DEFAULT_DATA_SOURCE=SIMULATED
