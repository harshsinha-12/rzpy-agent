# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKER_HEALTH_URL=http://localhost:4001
API_HOST=0.0.0.0
API_PORT=4000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001
# Hosted platforms such as Railway inject PORT, which takes precedence. The API
# and worker use API_PORT/WORKER_HEALTH_PORT only as local fallbacks.

# Local Docker defaults; replace only in an untracked .env file or hosted
# service secret store.
DATABASE_URL=postgresql://recoveryos:recoveryos@localhost:5432/recoveryos
DATABASE_POOL_MAX=3
# Hosted PostgreSQL URLs must retain the provider's TLS query parameters. For
# Aiven, keep ?sslmode=require and enter the complete rotated URL only in the
# Railway API and worker secret stores.
REDIS_URL=redis://localhost:6380
POSTGRES_PORT=5432
REDIS_PORT=6380

# Managed Redis alternative. When REDIS_URL is empty, the API and worker build
# it from these values. Set REDIS_TLS=true only when the provider connection
# wizard requires TLS. REDIS_URL takes precedence when both forms are present.
REDIS_HOST=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# Razorpay Test Mode — required starting in Plan Step 5
RAZORPAY_TEST_MODE_API_KEY=
RAZORPAY_TEST_MODE_SECRET_KEY=
# Optional until a public signed webhook is configured
RAZORPAY_WEBHOOK_SECRET=

# OpenAI — required starting in Plan Step 7
# Configure this on the worker only; the API does not call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Demo controls
DEMO_SEED=20260820
DEFAULT_DATA_SOURCE=SIMULATED
